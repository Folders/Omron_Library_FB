{"CLs":[{"__type":"LD","Ix":1,"Not":true,"Var":"started"},{"__type":"LD","Not":true,"Var":"ClockMgr.Sta.Fault","X":1},{"__type":"IST","EID":"f064fd99-0108-4f80-bdfc-94722d49eea2","H":577.33333333333337,"Ix":2,"TXT":"\/\/ Increment the instance counter\u000d\u000aInc(ClockMgr.Xch.NbTask);\u000d\u000a\u000d\u000a\/\/ The first instance will be the master\u000d\u000aIF ClockMgr.Xch.NbTask = USINT#1 THEN\u000d\u000a\u0009isMaster := TRUE;\u000d\u000a\u0009SIZE := SizeOfAry(ClockMgr.Tasks) - 1;\u000d\u000a\u0009ClockMgr.Xch.StartCounter := Get1usCnt();\u000d\u000aEND_IF;\u000d\u000a\u0009\u000d\u000a\/\/ Check if the local Id is correct, must be odd\u000d\u000aIF (ClockMgr.Xch.NbTask MOD 2) = 1 THEN\u000d\u000a\u0009\/\/ Compute the task id\u000d\u000a\u0009idTask := (ClockMgr.Xch.NbTask-1) \/ 2;\u000d\u000a\u0009\u000d\u000a\u0009\/\/ Set task information\u000d\u000a\u0009ClockMgr.Tasks[idTask].Enabled := TRUE;\u000d\u000a\u0009ClockMgr.Tasks[idTask].Name := Name;\u000d\u000a\u0009ClockMgr.Tasks[idTask].Id := idTask + 1;\u000d\u000a\u0009ClockMgr.Tasks[idTask].TaskPeriod := ULINT_TO_UINT(TimeToNanoSec(GetMyTaskInterval()) \/ 100000 );\u000d\u000a\u0009\u000d\u000aELSE\u000d\u000a\u0009\/\/ Put FB in fault\u000d\u000a\u0009ClockMgr.Sta.Fault := TRUE;\u000d\u000a\u0009ClockMgr.Msg.MissingEnd := TRUE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/ Init FB\u000d\u000astarted := TRUE;","W":1112.6666666666667,"X":2}],"CMT":"Increamente the \"idtask\" if we have  serveral FB","LI":3,"LRI":4,"Label":"EoF","RRI":5,"VLs":[]}
