{"CLs":[{"__type":"LD","Var":"ClockMgr.Sta.Busy"},{"__type":"IST","EID":"1a88c23a-8ddf-4b74-a521-b534d2c5870d","H":539,"Ix":1,"TXT":"\/\/ For each task\u000d\u000aFOR i := 0 TO SIZE DO\u000d\u000a    \/\/ Exit at last task\u000d\u000a\u0009IF NOT ClockMgr.Tasks[i].Enabled THEN\u000d\u000a\u0009\u0009EXIT;\u000d\u000a\u0009END_IF;\u000d\u000a\u0009\u000d\u000a\u0009\/\/ Compute the span\u000d\u000a\u0009ClockMgr.Tasks[i].Span := UINT_TO_REAL(ClockMgr.Tasks[i].Counter_End - ClockMgr.Tasks[i].Counter_Start);\u000d\u000a\u0009\u000d\u000a\u0009\/\/ Compute the MIN time\u000d\u000a\u0009IF ClockMgr.Tasks[i].Min = 0.0 THEN\u000d\u000a\u0009\u0009\/\/ At start, set MIN at span value\u000d\u000a\u0009\u0009ClockMgr.Tasks[i].Min := ClockMgr.Tasks[i].Span;\u000d\u000a\u0009END_IF;\u000d\u000a\u0009\u000d\u000a\u0009 IF  ClockMgr.Tasks[i].Span < ClockMgr.Tasks[i].Min  THEN\u000d\u000a\u0009\u0009 \/\/ Save minimum time\u000d\u000a\u0009\u0009ClockMgr.Tasks[i].Min := ClockMgr.Tasks[i].Span;\u000d\u000a\u0009END_IF;\u000d\u000a\u000d\u000a\u0009\/\/ Compute the MAX time\u000d\u000a\u0009IF  ClockMgr.Tasks[i].Span > ClockMgr.Tasks[i].Max  THEN\u000d\u000a\u0009\u0009ClockMgr.Tasks[i].Max := ClockMgr.Tasks[i].Span;\u000d\u000a\u0009END_IF;\u000d\u000a\u0009\u000d\u000aEND_FOR;","W":1178,"X":1}],"CMT":"Tasks measurement","LRI":2,"RRI":3,"VLs":[]}
{"CLs":[{"__type":"LD","Var":"ClockMgr.Cmd.Reset"},{"__type":"IST","EID":"431f5141-657e-4cb9-81a4-b66043ad15e3","H":269.33333333333326,"Ix":1,"TXT":"\/\/ For each task\u000d\u000aFOR i := 0 TO SIZE DO\u000d\u000a    \/\/ Exit at last task\u000d\u000a\u0009IF NOT ClockMgr.Tasks[i].Enabled THEN\u000d\u000a\u0009\u0009EXIT;\u000d\u000a\u0009END_IF;\u000d\u000a\u0009\u000d\u000a\u0009\/\/ Reset value\u000d\u000a\u0009ClockMgr.Tasks[i].Min := 0.0;\u000d\u000a\u0009ClockMgr.Tasks[i].Max := 0.0;\u000d\u000a\u0009ClockMgr.Tasks[i].Average := 0.0;\u000d\u000aEND_FOR;","W":616.66666666666652,"X":1}],"CMT":"Reset value Min \/ Max","LRI":2,"RRI":3,"VLs":[]}
