{"CLs":[{"__type":"LD","Var":"Inverters.Enable_Analog"},{"__type":"FB","In":[{"__type":"PRM","Arg":"MyInverter","IO":true,"Ix":1,"Type":"OBJ\\INVERTER\\BASE","Var":"Inverter_Pump"},{"__type":"PF","Arg":"Enable"},{"__type":"PRM","Arg":"AD_SpeedFeedback","Ix":2,"Type":"INT","Var":"Inverters.AD_SpeedFeedback"},{"__type":"PRM","Arg":"ID_DriveFault","Ix":3,"Type":"BOOL","Var":""},{"__type":"PRM","Arg":"VelocityRef","Ix":4,"Type":"REAL","Var":"Inverters.Velocity"},{"__type":"PRM","Arg":"TensionRef","Ix":5,"Type":"REAL","Var":"Inverters.Volt"},{"__type":"PRM","Arg":"VelocityUnit","Ix":6,"Type":"STRING[6]","Var":"'rpm'"},{"__type":"PRM","Arg":"VelocityMax","Ix":7,"Type":"REAL","Var":"Inverters.Vel_Max"},{"__type":"PRM","Arg":"TensionMax","Ix":8,"Type":"REAL","Var":"Inverters.Volt_Max"},{"__type":"PRM","Arg":"FactorAD","Ix":9,"Type":"REAL","Var":"400"},{"__type":"PRM","Arg":"Feedback_Used","Ix":10,"Type":"BOOL","Var":"true"},{"__type":"PRM","Arg":"Commissioning","Ix":11,"Type":"BOOL","Var":"Commissioning"}],"Ix":17,"Name":"Inverter_Config_Analogic","Out":[{"__type":"PRM","Arg":"MyInverter","IO":true,"Ix":12,"Type":"OBJ\\INVERTER\\BASE","Var":"Inverter_Pump"},{"__type":"PF","Arg":"ENO"},{"__type":"PRM","Arg":"DA_SpeedSetpoint","Ix":13,"Type":"INT","Var":"Inverters.DA_SpeedSetpoint"},{"__type":"PRM","Arg":"OD_CW","Ix":14,"Type":"BOOL","Var":"Inverters.DO_CW"},{"__type":"PRM","Arg":"OD_CCW","Ix":15,"Type":"BOOL","Var":"Inverters.DO_CCW"},{"__type":"PRM","Arg":"OD_Reset","Ix":16,"Type":"BOOL","Var":"Inverters.DO_Reset"}],"UD":true,"X":1,"Var":"configAnalog"}],"CMT":"Configures an inverter controlled through analog signals. The relationship between the machine velocity and the analog command is \u000d\u000adefined by VelocityRef and TensionRef. The block automatically converts user velocity commands into analog output values and optionally\u000d\u000aconverts analog feedback into the selected user unit.\u000a\u000aThe analog output scaling is defined by FactorAD. This value represents the conversion between the motor command voltage and the\u000d\u000araw analog output value used by the hardware.\u000a\u000aExample:\u000a   10 V = 4000\u000a   FactorAD = 400\u000a\u000a\u000aRun, direction, reset, and fault signals are managed through dedicated digital I\/O. When Feedback_Used is enabled, the analog feedback\u000d\u000ais converted using the same scaling parameters as the speed command.","LRI":18,"RRI":19,"VLs":[]}
