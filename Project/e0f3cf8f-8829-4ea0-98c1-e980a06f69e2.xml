{"CLs":[{"__type":"LD","Var":"connection_A"},{"__type":"FB","In":[{"__type":"PRM","Arg":"MyDB","IO":true,"Ix":2,"Type":"OBJ\\DB\\BASE","Var":"DB_Machine"},{"__type":"PF","Arg":"Enable"},{"__type":"PRM","Arg":"SourceName","Ix":3,"Type":"STRING[21]","Var":"'Test A'"},{"__type":"PRM","Arg":"Insert_Mapping_Error","Ix":4,"Type":"BOOL","Var":"map_A.Error"},{"__type":"PRM","Arg":"Insert_Mapping_ErrorID","Ix":5,"Type":"WORD","Var":"map_A.ErrorID"},{"__type":"PRM","Arg":"Insert_Error","Ix":6,"Type":"BOOL","Var":"insert_A.Error"},{"__type":"PRM","Arg":"Insert_ErrorID","Ix":7,"Type":"WORD","Var":"insert_A.ErrorID"},{"__type":"PRM","Arg":"Select_Mapping_Error","Ix":8,"Type":"BOOL","Var":""},{"__type":"PRM","Arg":"Select_Mapping_ErrorID","Ix":9,"Type":"WORD","Var":""},{"__type":"PRM","Arg":"Select_Error","Ix":10,"Type":"BOOL","Var":""},{"__type":"PRM","Arg":"Select_ErrorID","Ix":11,"Type":"WORD","Var":""},{"__type":"PRM","Arg":"Update_Mapping_Error","Ix":12,"Type":"BOOL","Var":""},{"__type":"PRM","Arg":"Update_Mapping_ErrorID","Ix":13,"Type":"WORD","Var":""},{"__type":"PRM","Arg":"Update_Error","Ix":14,"Type":"BOOL","Var":""},{"__type":"PRM","Arg":"Update_ErrorID","Ix":15,"Type":"WORD","Var":""}],"Ix":18,"Name":"DB_FaultDetection","Out":[{"__type":"PRM","Arg":"MyDB","IO":true,"Ix":16,"Type":"OBJ\\DB\\BASE","Var":"DB_Machine"},{"__type":"PF","Arg":"Resetting"},{"__type":"PRM","Arg":"InFault","Ix":17,"Type":"BOOL","Var":""}],"UD":true,"X":1,"Var":"error_A"},{"__type":"ST","Ix":1,"RS":true,"Var":"test_A","X":2}],"CMT":"S06V01: \u000d\u000a\u000d\u000aIn the event of a loss of communication with the database, the error is not necessarily reported by the DB_Connect FB.\u000a\u000aIf the connection is already open, the error may occur in another database action FB, such as DB_CreateMapping or DB_Insert.\u000d\u000aTherefore, the manager cannot directly detect this error.\u000a\u000aAn additional FB is required to monitor all database action instances and report communication errors back to the manager.\u000d\u000a\u000d\u000aThe monitoring FB supports the six most common database operations: Insert, Select, and Update, as well as their associated\u000d\u000amapping functions.\u000a\u000aIt monitors these database action instances and reports communication errors back to the manager. If the detected fault is \u000d\u000acaused by a database disconnection, the manager automatically attempts to restore the connection.\u000aFor any other error, a user reset via Cmd.Reset is required.","LRI":19,"RRI":20,"VLs":[]}
