    <DataType Name="eState" BaseType="ENUM" ArrayType="" Length="" InitialValue="" EnumValue="" Comment="" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="6fa32088-40f0-4b72-ad68-3bcd49159dae">
      <DataType Name="NotStarted" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="0" Comment="Machine state is not started" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="69d658d9-3fb5-4f74-b7a5-d91d6a72166a" />
      <DataType Name="Aborting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="1" Comment="The ABORTED state can be entered at any time in response to the Abort command or on the occurrence of a machine fault." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="b7ea66a0-f243-4709-b564-04e8289fbd66" />
      <DataType Name="Aborted" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="2" Comment="This state maintains machine status information relevant to the Abort condition. The Stop command will force transition to the Stopped state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="3fba9d0b-2492-434d-9e38-8f088c2b6576" />
      <DataType Name="Clearing" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="3" Comment="The procedural element has received a command to clear faults that may have occurred when ABORTING, and are present in the ABORTED state before proceeding to a STOPPED state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="2dfce2c4-d41a-4613-a90c-4d7ea3c5934c" />
      <DataType Name="Stopping" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="4" Comment="This state executes the logic which brings the machine to a controlled and safe stop" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="0cf8c262-5c4b-4fdf-9e6a-2cd557f8d6f5" />
      <DataType Name="Stopped" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="5" Comment="The machine is powered and stationary.  All communications with other systems are functioning " OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="e01ef590-9801-4277-883b-01f1a0dd62a6" />
      <DataType Name="Resetting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="6" Comment="This element is the result of a RESET command from the STOPPED state.  RESETTING will typically cause a machine to sound a horn and place the machine in a state where components are energized awaiting a START command" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="1b8e4754-36f6-4478-ad96-db0bf1170a54" />
      <DataType Name="Idle" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="7" Comment="This is a State which indicates that RESETING is complete.  This state maintains the machine conditions which were achieved during the RESET state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="f9c355ee-db35-4d92-9fb5-9ade007da609" />
      <DataType Name="Starting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="8" Comment="This state provides the steps needed to start the machine and is a result of a starting type command.  Following this command the machine will begin to “execute”." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="ebcf5aec-56b1-42d7-b3a8-c3bff1f5e824" />
      <DataType Name="Execute" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="9" Comment="Once the machine is processing materials it is deemed to be Executing or in the EXECUTE state.  Execute refers to the mode in which the machine is in." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="38be81ad-138c-41d9-bea2-72d3d87bb2d3" />
      <DataType Name="Holding" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="10" Comment="When the machine is in the EXECUTE state the Hold command can be used to start HOLDING logic which brings the machine to a controlled stop or to a state which represents HELD for the particular machine mode." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="bdd98563-e330-4875-9b28-6fbb04513389" />
      <DataType Name="Held" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="11" Comment="The HELD state would typically be used by the operator to hold the temporarily hold the machine's operation whilst material blockages are cleared, or to stop throughput whilst a downstream problem is resolved." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="dae07ac2-cf3e-4da9-ba38-6da6ffdb6252" />
      <DataType Name="Unholding" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="12" Comment="The UNHOLDING state is typically a response to an operator command to resume EXECUTE state.  UNHOLDING prepares the machine to re-enter the EXECUTE state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="f091b4c0-a979-4ebf-89b1-733bdcee932e" />
      <DataType Name="Suspending" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="13" Comment="This state is a result of a command change from the EXECUTE state.  This state is typically required prior to the SUSPENDED wait state, and prepares the machine (ie stops glue cycles, stops carton feeds, etc) prior to the SUSPEND state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="d66c5c6a-36ff-48c0-a5af-55993a408804" />
      <DataType Name="Suspended" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="14" Comment="The machine may be running at the relevant setpoint speed, there is no product being produced. This state can be reached as a result of a machine status, and differs from HELD in that HELD is typically a result of an operator request" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="385a08ae-abc6-4a49-a7de-706f8651d000" />
      <DataType Name="Unsuspending" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="15" Comment="This state is a result of a request from SUSPENDED state to go back to the EXECUTE state. This state is done prior to EXECUTE state, and prepares the machine for the EXECUTE state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="7e1e7af7-94c1-4b47-b2ec-70878664fe90" />
      <DataType Name="Completing" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="16" Comment="When the machine is in the EXECUTE state the Complete command can be used to start COMPLETED logic which brings the machine to a controlled stop" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="55961094-8a1e-45a8-a1c4-d0ff5ff9e191" />
      <DataType Name="Completed" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="17" Comment="The machine has finished the COMPLETING state and is now waiting for a STOP command that will cause a transition to the STOPPED state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="5de0bfd0-8eae-40bf-851e-19f771f0b324" />
      <DataType Name="ErrorState" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="20" Comment="Machine state in error" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="cd9a6511-d198-46f2-a1b2-5ff85c598cee" />
    </DataType>
