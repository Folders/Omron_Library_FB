    <DataType Name="eState" BaseType="ENUM" ArrayType="" Length="" InitialValue="" EnumValue="" Comment="" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="2285d105-5563-4438-a273-69a5e59d10c5">
      <DataType Name="NotStarted" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="0" Comment="Machine state is not started" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="bbd41891-3d87-4927-81d4-ff5d51a9854f" />
      <DataType Name="Aborting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="1" Comment="The ABORTED state can be entered at any time in response to the Abort command or on the occurrence of a machine fault." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="b5340f31-b5d2-4466-9427-887837b26605" />
      <DataType Name="Aborted" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="2" Comment="This state maintains machine status information relevant to the Abort condition. The Stop command will force transition to the Stopped state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="3fee931e-6fb1-488b-9fdc-663d35df567d" />
      <DataType Name="Clearing" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="3" Comment="The procedural element has received a command to clear faults that may have occurred when ABORTING, and are present in the ABORTED state before proceeding to a STOPPED state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="88ca2a68-a9c7-49bb-8eba-c2806c709c36" />
      <DataType Name="Stopping" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="4" Comment="This state executes the logic which brings the machine to a controlled and safe stop" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="8fc68454-591c-41b3-9841-5ad9a7973579" />
      <DataType Name="Stopped" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="5" Comment="The machine is powered and stationary.  All communications with other systems are functioning " OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="57151799-1f81-422f-a25f-b7e2ff446a51" />
      <DataType Name="Resetting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="6" Comment="This element is the result of a RESET command from the STOPPED state.  RESETTING will typically cause a machine to sound a horn and place the machine in a state where components are energized awaiting a START command" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="bb0d707b-dd1d-4933-b20c-b3f1b721cff3" />
      <DataType Name="Idle" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="7" Comment="This is a State which indicates that RESETING is complete.  This state maintains the machine conditions which were achieved during the RESET state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="cffabbc0-d676-4c8e-8a1f-3ecacafab8be" />
      <DataType Name="Starting" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="8" Comment="This state provides the steps needed to start the machine and is a result of a starting type command.  Following this command the machine will begin to “execute”." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="06363a3d-2b81-456a-98c4-5e51c092712a" />
      <DataType Name="Execute" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="9" Comment="Once the machine is processing materials it is deemed to be Executing or in the EXECUTE state.  Execute refers to the mode in which the machine is in." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="1cfe61da-8a32-40ba-bc00-059a395cd20a" />
      <DataType Name="Holding" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="10" Comment="When the machine is in the EXECUTE state the Hold command can be used to start HOLDING logic which brings the machine to a controlled stop or to a state which represents HELD for the particular machine mode." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="fba9bd1d-1c84-4951-90b4-133254df8dca" />
      <DataType Name="Held" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="11" Comment="The HELD state would typically be used by the operator to hold the temporarily hold the machine's operation whilst material blockages are cleared, or to stop throughput whilst a downstream problem is resolved." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="e272f8ed-7c06-4f7b-a482-4d85ee5e8234" />
      <DataType Name="Unholding" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="12" Comment="The UNHOLDING state is typically a response to an operator command to resume EXECUTE state.  UNHOLDING prepares the machine to re-enter the EXECUTE state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="07e4f3ba-3a77-427e-a192-8713ec3e1429" />
      <DataType Name="Suspending" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="13" Comment="This state is a result of a command change from the EXECUTE state.  This state is typically required prior to the SUSPENDED wait state, and prepares the machine (ie stops glue cycles, stops carton feeds, etc) prior to the SUSPEND state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="e79d3478-789e-4d6a-9bca-d8a27414cacc" />
      <DataType Name="Suspended" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="14" Comment="The machine may be running at the relevant setpoint speed, there is no product being produced. This state can be reached as a result of a machine status, and differs from HELD in that HELD is typically a result of an operator request" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="5c3dade3-eab1-4542-b086-5d6f4487d675" />
      <DataType Name="Unsuspending" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="15" Comment="This state is a result of a request from SUSPENDED state to go back to the EXECUTE state. This state is done prior to EXECUTE state, and prepares the machine for the EXECUTE state." OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="848ba6bb-c6f0-4c59-9c4c-bc92e76fa943" />
      <DataType Name="Completing" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="16" Comment="When the machine is in the EXECUTE state the Complete command can be used to start COMPLETED logic which brings the machine to a controlled stop" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="89072517-1d24-40eb-b764-c86f5b464ca5" />
      <DataType Name="Completed" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="17" Comment="The machine has finished the COMPLETING state and is now waiting for a STOP command that will cause a transition to the STOPPED state" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="958a8d11-69e9-4804-bec3-b4428dd1f09b" />
      <DataType Name="ErrorState" BaseType="DINT" ArrayType="" Length="" InitialValue="" EnumValue="20" Comment="Machine state in error" OffsetChannel="" OffsetBit="" IsControllerDefinedType="false" Order="0" OffsetType="" Id="f24e3497-aba8-473e-9abf-999309931e5a" />
    </DataType>
