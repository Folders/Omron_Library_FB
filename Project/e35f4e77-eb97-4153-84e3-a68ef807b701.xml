{"CLs":[{"__type":"F","In":[{"__type":"PF","Arg":"EN"},{"__type":"PRM","Arg":"In1","Ix":1,"Type":"ANY_ELEMENTARY, ENUM","Var":"stepTrigg"},{"__type":"PRM","Arg":"In2","Ix":2,"Type":"ANY_ELEMENTARY, ENUM","Var":"60"}],"Ix":3,"Name":"=","Out":[{"__type":"PF","Arg":""}],"PL":true},{"__type":"LD","Var":"MyCamera.Cmd.ReadData","Y":1},{"__type":"IST","EID":"3d810e65-a07b-4520-947e-4a5f3d72cf5f","H":427.14285714285563,"Ix":4,"TXT":"\/\/ Get InspectionResult for know if the image is OK or NG, 0 = Out off service, 1 = OK, 2 = NG, 3 = Fault\u000d\u000aMyCamera.Xch.InspectionResult := EIP_FromCamera.InspectionResult_code;\u000d\u000a\/\/ Read InspectionResult\u000d\u000a\/\/Result Fault\u000d\u000aIF MyCamera.Xch.InspectionResult = 3 THEN\u000d\u000a\u0009MyCamera.Image.Fault := TRUE;\u000d\u000aELSE \u000d\u000a\u0009MyCamera.Image.Fault := FALSE;\u000d\u000aEND_IF;\u000d\u000a\/\/Result NG\u000d\u000aIF MyCamera.Xch.InspectionResult = 2 THEN\u000d\u000a\u0009\u0009MyCamera.Image.NG := TRUE;\u000d\u000a\u0009\u0009\/\/Inc(MyCamera.Image.CounterNG);\u000d\u000aELSE \u000d\u000a\u0009MyCamera.Image.NG := FALSE;\u000d\u000aEND_IF;\u000d\u000a\/\/Result OK\u000d\u000aIF MyCamera.Xch.InspectionResult = 1 THEN\u000d\u000a\u0009\u0009MyCamera.Image.OK := TRUE;\u000d\u000a\u0009\u0009\/\/Inc(MyCamera.Image.CounterOK);\u000d\u000aELSE \u000d\u000a\u0009MyCamera.Image.OK := FALSE;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/ Get SelfCheck result\u000d\u000aMyCamera.Image.CheckLight.Selected := TestABit(EIP_FromCamera.SelfCheck,3);\u000d\u000aMyCamera.Image.CheckLight.Activated := TestABit(EIP_FromCamera.SelfCheck,2);\u000d\u000aMyCamera.Image.CheckLight.Fault := NOT TestABit(EIP_FromCamera.SelfCheck,1);\u000d\u000aMyCamera.Image.CheckLight.Result := TestABit(EIP_FromCamera.SelfCheck,0);\u000d\u000a\u000d\u000a\/\/ Get PartCheck result for know if tte PART is in field of view and if the fixturing is done\u000d\u000aMyCamera.Image.CheckPart.Selected := TestABit(EIP_FromCamera.PartCheck,3);\u000d\u000aMyCamera.Image.CheckPart.Activated := TestABit(EIP_FromCamera.PartCheck,2);\u000d\u000aMyCamera.Image.CheckPart.Fault := NOT TestABit(EIP_FromCamera.PartCheck,1);\u000d\u000aMyCamera.Image.CheckPart.Result := TestABit(EIP_FromCamera.PartCheck,0);\u000d\u000a\u000d\u000a\/\/ Get all feedback\u000d\u000aMyCamera.Xch.Feedback := EIP_FromCamera.Feedback;\u000d\u000a\u000d\u000a\/\/ Read checkers status and write in the structure\u000d\u000aFOR i := 0 TO sizeCheckers BY 1 DO\u000d\u000a\u0009MyCamera.Image.Checkers[i].Selected := TestABit(EIP_FromCamera.CheckersStatus[i],3);\u000d\u000a\u0009MyCamera.Image.Checkers[i].Activated := TestABit(EIP_FromCamera.CheckersStatus[i],2);\u000d\u000a\u0009MyCamera.Image.Checkers[i].Fault := NOT TestABit(EIP_FromCamera.CheckersStatus[i],1);\u000d\u000a\u0009MyCamera.Image.Checkers[i].Result := TestABit(EIP_FromCamera.CheckersStatus[i],0);\u000d\u000aEND_FOR;\u000d\u000a\u000d\u000a\/\/ Next step\u000d\u000aIF MyCamera.Cmd.ReadData THEN\u000d\u000a\u0009stepTrigg :=99;\u000d\u000aELSE \u000d\u000a\u0009stepTrigg := 61;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/ Reset busyTrigger\u000d\u000abusyTrigger := FALSE;","W":747.99999999999977,"X":1}],"CMT":"60: Update value","LRI":5,"RRI":6,"VLs":[{"Ix":7,"X":1}]}
{"CLs":[{"__type":"F","In":[{"__type":"PF","Arg":"EN"},{"__type":"PRM","Arg":"In1","Type":"ANY_ELEMENTARY, ENUM","Var":"stepTrigg"},{"__type":"PRM","Arg":"In2","Ix":1,"Type":"ANY_ELEMENTARY, ENUM","Var":"61"}],"Ix":2,"Name":"=","Out":[{"__type":"PF","Arg":""}],"PL":true},{"__type":"IST","EID":"38b29574-46a2-43b4-85f0-75464eeb4f59","H":264.28571428571456,"Ix":3,"TXT":"\/\/ Count number of acquisition (OK+NG+Fault)\u000d\u000aInc(MyCamera.Image.Counter);\u000d\u000a\/\/ Count Result NG\u000d\u000aIF MyCamera.Image.NG THEN\u000d\u000a\u0009Inc(MyCamera.Image.CounterNG);\u000d\u000aEND_IF;\u000d\u000a\/\/ Count Result OK\u000d\u000aIF \u0009MyCamera.Image.OK THEN\u000d\u000a\u0009Inc(MyCamera.Image.CounterOK);\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/Counter SelfCheck result\u000d\u000aInc(MyCamera.Image.CheckLight.Counter);\u000d\u000aIF MyCamera.Image.CheckLight.Activated THEN\u000d\u000a\u0009IF MyCamera.Image.CheckLight.Result THEN\u000d\u000a\u0009\u0009\u0009inc(MyCamera.Image.CheckLight.CounterOK);\u000d\u000a\u0009\u0009ELSE\u000d\u000a\u0009\u0009\u0009Inc(MyCamera.Image.CheckLight.CounterNG);\u000d\u000a\u0009END_IF;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\/\/Counter PartCheck result for know if tte PART is in field of view and if the fixturing is done\u000d\u000aIF MyCamera.Image.CheckLight.Result THEN\u000d\u000a\u0009Inc(MyCamera.Image.CheckPart.Counter);\u000d\u000a\u0009IF MyCamera.Image.CheckPart.Result  THEN\u000d\u000a\u0009\u0009\u0009\u0009inc(MyCamera.Image.CheckPart.CounterOK);\u000d\u000a\u0009\u0009\u0009ELSE\u000d\u000a\u0009\u0009\u0009\u0009Inc(MyCamera.Image.CheckPart.CounterNG);\u000d\u000a\u0009END_IF;\u000d\u000aEND_IF;\u000d\u000a\u000d\u000a\u0009\u0009\/\/Counter Checkers\u000d\u000a\u0009FOR i := 0 TO sizeCheckers BY 1 DO\u000d\u000a\u0009\u0009IF MyCamera.Image.Checkers[i].Activated THEN\u000d\u000a\u0009\u0009\u0009Inc(MyCamera.Image.Checkers[i].Counter);\u000d\u000a\u0009\u0009\u0009IF NOT MyCamera.Image.Checkers[i].Fault THEN\u000d\u000a\u0009\u0009\u0009\u0009IF MyCamera.Image.Checkers[i].Result THEN\u000d\u000a\u0009\u0009\u0009\u0009\u0009inc(MyCamera.Image.Checkers[i].CounterOK);\u000d\u000a\u0009\u0009\u0009\u0009ELSE\u000d\u000a\u0009\u0009\u0009\u0009\u0009Inc(MyCamera.Image.Checkers[i].CounterNG);\u000d\u000a\u0009\u0009\u0009\u0009END_IF;\u000d\u000a\u0009\u0009\u0009END_IF;\u0009\u000d\u000a\u0009\u0009END_IF;\u000d\u000a\u0009END_FOR;\u000d\u000a\u000d\u000a\u0009stepTrigg := 70;\u000d\u000a","W":750.28571428571445,"X":1}],"CMT":"61: Counter status","LRI":4,"RRI":5,"VLs":[]}
